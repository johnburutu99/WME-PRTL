# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the NestJS backend — used by the server-side Next.js proxy only.
# Never exposed to the browser directly.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production
