# ─── Backend API ──────────────────────────────────────────────────────────────
# Private server-side URL of the NestJS backend — used by the Next.js proxy only.
# NOT prefixed with NEXT_PUBLIC_ — never bundled into the browser.
# Set this to your Railway / Render / Fly.io backend URL in production.
BACKEND_API_URL=http://localhost:3001

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production
