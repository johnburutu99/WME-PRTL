# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Use the Supabase "Session mode" pooler URL (port 5432) for Prisma.
# Found in: Supabase Dashboard → Settings → Database → Connection String → URI
# Use the pooler (Transaction mode port 6543) for serverless; Session mode for
# persistent servers like Railway/Render.
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-us-west-1.pooler.supabase.com:5432/postgres"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — Must be a strong random string (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# REQUIRED — Shared HMAC secret between WME backend and your payment/esign provider.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ─── Redis ────────────────────────────────────────────────────────────────────
# On Render: REDIS_URL is auto-injected from the linked Redis service.
# On local dev: set individual vars below.
# REDIS_URL=redis://:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The URL of the frontend — must be exact (no trailing slash)
FRONTEND_URL=http://localhost:3000
