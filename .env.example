# ─── WME Portal — Environment Variables ──────────────────────────────────────
# Copy to frontend/.env.local and fill in values before running locally.
# Set these as environment variables in your Vercel project dashboard.

# ─── Supabase (public — safe for browser) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# ─── Supabase (private — server-side only, NEVER expose to browser) ────────────
# Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe (private — server-side only) ──────────────────────────────────────
# Stripe Dashboard → Developers → API Keys → Secret key
# Required to enable 50% deposit checkout flow in the Buyer portal.
STRIPE_SECRET_KEY=sk_live_...

# ─── App URL (used for Stripe success/cancel redirects + password reset links) ─
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
