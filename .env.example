# ─── WME Portal — Root Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in all values before running docker-compose.
# NEVER commit .env to source control.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=wme_portal

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ─── Webhooks ──────────────────────────────────────────────────────────────────
# Shared HMAC secret between backend and your payment/esign provider
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# ─── CORS / Frontend ───────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=http://backend:3001
